#!/bin/sh
# SPDX-License-Identifier: BSD-3-Clause
# GN3002 mainline bring-up initramfs
export PATH=/bin:/sbin:/usr/bin:/usr/sbin
export HOME=/

# 让所有 busybox applet 都能用（initramfs 是 ramfs，可写）
/bin/busybox --install -s /bin 2>/dev/null

mount -t devtmpfs devtmpfs /dev 2>/dev/null
mkdir -p /dev/pts /proc /sys /tmp
mount -t proc proc /proc 2>/dev/null
mount -t sysfs sysfs /sys 2>/dev/null
mount -t devpts devpts /dev/pts 2>/dev/null

if [ -c /dev/console ]; then
	exec >/dev/console 2>&1 </dev/console
fi

echo ""
echo "################################################"
echo "#  GN3002 mainline kernel - initramfs reached  #"
echo "################################################"
# 某些平台 /dev/console 未能建立时，通过 kmsg 保证标记能出现在串口日志里
[ -w /dev/kmsg ] && \
	echo "<6>GN3002 mainline kernel - initramfs reached" > /dev/kmsg
uname -a
echo "cmdline: $(cat /proc/cmdline)"
echo
echo "--- framebuffer ---"
cat /proc/fb 2>/dev/null
for f in mode stride virtual_size bits_per_pixel; do
	printf "fb0/%s = " "$f"; cat /sys/class/graphics/fb0/$f 2>/dev/null
done
echo
echo "--- memory ---"
head -3 /proc/meminfo
echo
echo "--- block devices ---"
ls /dev/mmcblk* 2>/dev/null
echo
echo "--- i2c adapters ---"
ls /sys/class/i2c-adapter 2>/dev/null
ls /sys/bus/i2c/devices 2>/dev/null
echo
echo "--- input ---"
grep -E "^N:|^P:" /proc/bus/input/devices 2>/dev/null
echo
echo "--- pstore ---"
ls /sys/fs/pstore 2>/dev/null
echo

# 没有 UART 时的救命通道：USB CDC-ACM 控制台
mount -t configfs none /sys/kernel/config 2>/dev/null
if [ -n "$(ls /sys/class/udc 2>/dev/null)" ]; then
	G=/sys/kernel/config/usb_gadget/gn3002
	mkdir -p "$G" 2>/dev/null
	(
		cd "$G" || exit 0
		echo 0x1d6b > idVendor
		echo 0x0104 > idProduct
		mkdir -p strings/0x409
		echo "Gionee" > strings/0x409/manufacturer
		echo "GN3002 mainline" > strings/0x409/product
		echo "0001" > strings/0x409/serialnumber
		mkdir -p configs/c.1/strings/0x409
		echo "ACM" > configs/c.1/strings/0x409/configuration
		mkdir -p functions/acm.usb0
		ln -s functions/acm.usb0 configs/c.1/ 2>/dev/null
		ls /sys/class/udc > UDC 2>/dev/null
	)
	i=0
	while [ ! -c /dev/ttyGS0 ] && [ $i -lt 10 ]; do
		sleep 1
		i=$((i + 1))
	done
	if [ -c /dev/ttyGS0 ]; then
		echo "USB ACM console ready on /dev/ttyGS0"
		( while true; do sh </dev/ttyGS0 >/dev/ttyGS0 2>&1; sleep 1; done ) &
	fi
else
	echo "no UDC registered (usb gadget unavailable)"
fi

echo "=== shell on tty0 (framebuffer console) ==="
( while true; do sh </dev/tty0 >/dev/tty0 2>&1; sleep 1; done ) &

while true; do
	sleep 3600
done
